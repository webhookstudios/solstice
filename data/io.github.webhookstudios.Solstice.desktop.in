[Desktop Entry]
Type=Application
Name=Solstice
GenericName=HDR Settings
Comment=Turn HDR on and tune brightness, refresh rate and color for each display
Exec=@EXEC@
Icon=@ICON@
Terminal=false
Categories=Settings;HardwareSettings;GNOME;GTK;
Keywords=gleam;sedge;hdr;display;monitor;brightness;nits;color;vrr;refresh;
StartupWMClass=io.github.webhookstudios.Solstice
Actions=hdr-on;hdr-off;hdr-toggle;

[Desktop Action hdr-on]
Name=Turn HDR On
Exec=@EXEC@ on

[Desktop Action hdr-off]
Name=Turn HDR Off
Exec=@EXEC@ off

[Desktop Action hdr-toggle]
Name=Toggle HDR
Exec=@EXEC@ toggle
